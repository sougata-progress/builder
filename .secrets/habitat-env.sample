#!/bin/sh
# ---------------------------------------------------------------------------
# SAMPLE ONLY – copy to .secrets/habitat-env and fill in real values.
# NEVER commit a file containing real credentials to version control.
# ---------------------------------------------------------------------------

APP_HOSTNAME="localhost"
OAUTH_PROVIDER="github"
OAUTH_USERINFO_URL="https://api.github.com/user"
OAUTH_AUTHORIZE_URL="https://github.com/login/oauth/authorize"
OAUTH_TOKEN_URL="https://github.com/login/oauth/access_token"
OAUTH_CLIENT_ID="<YOUR_OAUTH_CLIENT_ID>"
OAUTH_CLIENT_SECRET="<YOUR_OAUTH_CLIENT_SECRET>"
OAUTH_REDIRECT_URL="http://localhost/"
GITHUB_API_URL="https://api.github.com"
GITHUB_APP_ID=<YOUR_GITHUB_APP_ID>
GITHUB_APP_URL="https://github.com/apps/<YOUR_GITHUB_APP_SLUG>"
